{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I\"E:/vspkg/installed/x64-mingw-dynamic/include\"",
                "-L\"E:/vspkg/installed/x64-mingw-dynamic/lib\"",
                "-lmingw32",
                "-lSDL2main",
                "-lSDL2",
                "-lm",
                "-ldinput8",
                "-ldxguid",
                "-ldxerr8",
                "-luser32",
                "-lgdi32",
                "-lwinmm",
                "-limm32",
                "-lole32",
                "-loleaut32",
                "-lshell32",
                "-lversion",
                "-luuid",
                "-static-libgcc",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ],
    "version": "2.0.0"
}